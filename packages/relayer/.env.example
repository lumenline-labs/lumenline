# Copy this file to .env and fill in real values. NEVER commit .env — it holds real secrets.
# See README.md's "Environment variables" section for the full explanation of each one.

# --- Genuinely required: the relayer refuses to start without these ---
LUMENLINE_NETWORK=testnet
POSTGRES_PASSWORD=change-me
LUMENLINE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
LUMENLINE_SPONSOR_SECRET=
# Gates POST/DELETE /admin/api-keys. Genuinely more sensitive than any integrator API key it
# issues — generate a real, separate secret (e.g. `openssl rand -hex 32`), never reuse one of the
# secrets above. See README.md's "Admin: issuing and revoking real integrator API keys" section.
LUMENLINE_ADMIN_SECRET=

# --- Spend-related, required, NO default (the relayer refuses to start without these too) ---
LUMENLINE_MAX_FEE_BUMP_STROOPS=10000000
LUMENLINE_DAILY_SPEND_CEILING_STROOPS=1000000000
LUMENLINE_MAX_TRANSFERS_PER_RECIPIENT=5
LUMENLINE_RECIPIENT_RATE_LIMIT_WINDOW_MS=3600000

# --- Allowed sensible defaults (performance/load knobs, not money-safety controls) ---
# Uncomment and change only if you need something other than the documented default.
# PORT=8080
# LUMENLINE_POLL_INTERVAL_MS=2000
# LUMENLINE_POLL_MAX_INTERVAL_MS=30000
# LUMENLINE_MAX_CONCURRENT_TRANSFERS=20
# LUMENLINE_REGISTRATION_LIMIT_MAX_ATTEMPTS=60
# LUMENLINE_REGISTRATION_LIMIT_WINDOW_MS=60000
# LUMENLINE_RELAYER_VERSION=0.0.0
# POSTGRES_HOST_PORT=5432

# --- CORS: optional even in production, but FAILS CLOSED (no browser origin allowed) when unset —
# never defaults to allow-all. Only needed if a browser-based caller (e.g. <lumenline-widget>
# hosted on a different origin than this relayer) will call this relayer directly; server-to-server
# callers are unaffected either way. See README.md's env var table / src/config.ts's
# RelayerConfig.corsOrigins doc comment for the full story. NEVER set this to "*".
# LUMENLINE_CORS_ORIGINS=https://your-widget-host.example.com,http://localhost:4173

# --- Outbound (Stellar -> EVM): OPT-IN, defaults to disabled. Leave LUMENLINE_OUTBOUND_ENABLED
# unset/false to run inbound-only (nothing below this line is read or required in that case). Set
# it to "true" and fill in every var below to also run the outbound direction in this same process
# — see README.md's "Outbound (Stellar -> EVM)" section for the full explanation. ---
LUMENLINE_OUTBOUND_ENABLED=false
# LUMENLINE_OUTBOUND_DESTINATION_CHAIN=ethereum-sepolia
# LUMENLINE_OUTBOUND_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# LUMENLINE_OUTBOUND_SPONSOR_SECRET=
# --- Outbound spend-related, required (no default) once LUMENLINE_OUTBOUND_ENABLED=true ---
# LUMENLINE_OUTBOUND_MAX_GAS_WEI=5000000000000000
# LUMENLINE_OUTBOUND_DAILY_GAS_CEILING_WEI=50000000000000000
# LUMENLINE_OUTBOUND_MAX_TRANSFERS_PER_RECIPIENT=5
# LUMENLINE_OUTBOUND_RECIPIENT_RATE_LIMIT_WINDOW_MS=3600000
# --- Outbound performance/load knobs, allowed sensible defaults ---
# LUMENLINE_OUTBOUND_POLL_INTERVAL_MS=2000
# LUMENLINE_OUTBOUND_POLL_MAX_INTERVAL_MS=30000
# LUMENLINE_OUTBOUND_MAX_CONCURRENT_TRANSFERS=20
